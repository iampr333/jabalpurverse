---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Support · Jabalpurverse" description="Voluntary support for Jabalpurverse">
  <main class="relative z-10 mx-auto max-w-xl px-4 py-10 sm:px-6">
    <p class="mb-4">
      <a class="text-river underline-offset-2 hover:underline" href="/">← Jabalpurverse</a>
    </p>
    <h1 class="mb-3 font-display text-3xl text-river-deep">Support</h1>
    <p class="mb-6 text-muted">
      UPI donate and transparency page land in P1. Support is optional; the site stays free.
    </p>
    <div
      class="rounded-xl border border-diya/30 bg-marble/70 p-5 text-sm text-muted backdrop-blur-sm"
    >
      <p lang="hi" class="mb-1 font-display text-river">नर्मदे हर</p>
      <p>
        A calm place for the city — funded later by voluntary support, never by blocking content.
      </p>
    </div>
  </main>
</BaseLayout>
