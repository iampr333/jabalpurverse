---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SiteNav } from "../components/SiteNav";
---

<BaseLayout title="Support · Jabalpurverse" description="Voluntary support for Jabalpurverse" river>
  <div class="support">
    <SiteNav client:load variant="page" current="support" />

    <main class="support__main">
      <p class="support__greeting" data-jv-greeting>
        <span lang="hi">नर्मदे हर</span>
        <span aria-hidden="true"> · </span>
        <span>Narmade Har</span>
      </p>
      <h1 class="support__title">
        <span data-en>Support</span>
        <span data-hi>सहयोग</span>
      </h1>
      <p class="support__lead">
        <span data-en>
          UPI donate and transparency page land in a later P1 slice. Support is optional; the site
          stays free.
        </span>
        <span data-hi>
          UPI दान और पारदर्शिता पृष्ठ बाद के P1 स्लाइस में आएगा। सहयोग वैकल्पिक है; साइट निःशुल्क
          रहती है।
        </span>
      </p>
      <p class="support__body">
        <span data-en>
          A calm place for the city — funded later by voluntary support, never by blocking content.
        </span>
        <span data-hi>
          शहर के लिए शांत जगह — बाद में स्वैच्छिक सहयोग से; कभी सामग्री रोककर नहीं।
        </span>
      </p>
    </main>

    <footer class="support__foot">
      <p>Jabalpur · Madhya Pradesh</p>
    </footer>
  </div>
</BaseLayout>
