---
import BaseLayout from "../layouts/BaseLayout.astro";
import LandmarkSilhouettes from "../components/LandmarkSilhouettes.astro";
import { ShellChrome } from "../components/ShellChrome";
import { SmoothScroll } from "../components/SmoothScroll";
---

<BaseLayout title="Jabalpurverse · नर्मदे हर">
  <SmoothScroll client:load />
  <ShellChrome client:load />
  <LandmarkSilhouettes />
  <footer class="home-foot">
    <p>
      <span lang="hi">नर्मदे हर</span> · Jabalpur · Madhya Pradesh
    </p>
  </footer>
</BaseLayout>

<style>
  .home-foot {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 1.25rem clamp(1.15rem, 4vw, 2rem) 1.75rem;
    background: #0a4f51;
    color: color-mix(in srgb, #f7f5f1 70%, transparent);
    font-size: 0.9rem;
  }

  .home-foot p {
    margin: 0;
    max-width: 72rem;
  }
</style>
