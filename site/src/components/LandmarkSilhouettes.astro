---
/**
 * Stacked full-bleed place chapters after the Narmada hero.
 * Order: Dhuandhar → Madan Mahal → Marble Rocks. Soft top fades + overlap.
 */
const landmarks = [
  {
    id: "dhuandhar",
    nameHi: "धुआँधार",
    nameEn: "Dhuandhar",
    hintHi: "नर्मदा जलप्रपात",
    hintEn: "Narmada falls",
    image: "/images/atmosphere/dhuandhar-falls.jpg",
    imageAlt: "Dhuandhar Falls on the Narmada near Bhedaghat",
    position: "center 40%",
  },
  {
    id: "madan-mahal",
    nameHi: "मदन महल",
    nameEn: "Madan Mahal",
    hintHi: "पहाड़ी किला",
    hintEn: "Hill fort",
    image: "/images/atmosphere/madan-mahal-fort.jpg",
    imageAlt: "Madan Mahal fort on the hill overlooking Jabalpur",
    position: "center 72%",
  },
  {
    id: "marble-rocks",
    nameHi: "संगमरमर चट्टानें",
    nameEn: "Marble Rocks",
    hintHi: "भेड़ाघाट",
    hintEn: "Bhedaghat",
    image: "/images/atmosphere/marble-rocks-bhedaghat.jpg",
    imageAlt: "Marble Rocks gorge on the Narmada at Bhedaghat",
    position: "center 55%",
  },
] as const;
---

<div class="chapters" aria-label="Jabalpur places along the Narmada">
  <div class="chapters__join" aria-hidden="true"></div>
  {
    landmarks.map((place, index) => (
      <section
        class:list={[
          "chapter",
          index === 0 && "chapter--first",
          index === landmarks.length - 1 && "chapter--last",
        ]}
        id={place.id}
      >
        <img
          class="chapter__photo"
          src={place.image}
          alt={place.imageAlt}
          width="1600"
          height="1067"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          style={`object-position: ${place.position}`}
        />
        <div class="chapter__veil" aria-hidden="true" />
        <div class="chapter__copy">
          <h2 class="chapter__name">
            <span lang="hi">{place.nameHi}</span>
            <span class="chapter__sep" aria-hidden="true">
              ·
            </span>
            <span>{place.nameEn}</span>
          </h2>
          <p class="chapter__hint">
            <span lang="hi">{place.hintHi}</span>
            <span aria-hidden="true"> · </span>
            <span>{place.hintEn}</span>
          </p>
        </div>
      </section>
    ))
  }
  <p class="chapters__credit">
    Photos: Wikimedia Commons (CC BY-SA) ·
    <a href="/images/credits/ATTRIBUTION.md">Attribution</a>
  </p>
</div>

<style>
  .chapters {
    width: 100%;
    margin: 0;
    /* No solid teal between photos — only credit/footer use river wash. */
    background: transparent;
    position: relative;
    z-index: 1;
  }

  /* Tiny corridor only between Narmada hero and Dhuandhar. */
  .chapters__join {
    height: 2vh;
    min-height: 0.75rem;
    background: #0a4f51;
  }

  .chapter {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    margin-top: 0;
    z-index: 1;
  }

  /* Stacking: earlier place stays above the next so its bottom fade reveals it. */
  .chapter--first {
    z-index: 3;
  }

  .chapter:not(.chapter--first):not(.chapter--last) {
    z-index: 2;
  }

  .chapter--last {
    z-index: 1;
  }

  /*
   * Soft photo→photo dissolve: fade the bottom of each chapter (except last)
   * so the next photo shows through — no teal band, no hard cut.
   */
  .chapter:not(.chapter--last) {
    margin-bottom: -18vh;
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 72%,
      rgba(0, 0, 0, 0.65) 82%,
      rgba(0, 0, 0, 0.25) 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      180deg,
      #000 0%,
      #000 72%,
      rgba(0, 0, 0, 0.65) 82%,
      rgba(0, 0, 0, 0.25) 92%,
      transparent 100%
    );
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  /* Soft entry only on the first place photo (after sunset hero). */
  .chapter--first::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 10vh;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      #0a4f51 0%,
      rgba(10, 79, 81, 0.7) 30%,
      rgba(10, 79, 81, 0.25) 65%,
      transparent 100%
    );
  }

  /* Soft exit only into the footer credit. */
  .chapter--last::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 10vh;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(10, 79, 81, 0.25) 45%,
      rgba(10, 79, 81, 0.7) 75%,
      #0a4f51 100%
    );
  }

  .chapter__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Readability under captions only — keep out of the photo dissolve zone. */
  .chapter__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 70%,
      rgba(10, 79, 81, 0.22) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .chapter:not(.chapter--last) .chapter__veil {
    display: none;
  }

  .chapter__copy {
    position: relative;
    z-index: 3;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem) clamp(2.75rem, 10vh, 4.5rem);
    max-width: 40rem;
    color: #f7f5f1;
    text-shadow: 0 1px 18px color-mix(in srgb, #0a4f51 55%, transparent);
    opacity: 0;
    transform: translateY(1.25rem);
    animation: chapter-in 0.9s ease forwards;
    animation-timeline: view();
    animation-range: entry 15% cover 40%;
  }

  /* Keep captions above the dissolve so the blend stays clean. */
  .chapter:not(.chapter--last) .chapter__copy {
    padding-bottom: clamp(5.5rem, 24vh, 10rem);
  }

  @supports not (animation-timeline: view()) {
    .chapter__copy {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .chapter__name {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .chapter__sep {
    margin-inline: 0.35rem;
    opacity: 0.7;
    font-weight: 500;
  }

  .chapter__hint {
    margin: 0;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    opacity: 0.9;
  }

  .chapters__credit {
    margin: -2vh 0 0;
    padding: 2.5rem 1.25rem 1.25rem;
    font-size: 0.72rem;
    color: color-mix(in srgb, #f7f5f1 60%, transparent);
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, #0a4f51 75%, #1a1c1b) 45%,
      #0a4f51 100%
    );
    position: relative;
    z-index: 2;
  }

  .chapters__credit a {
    color: #d5ecec;
    text-underline-offset: 2px;
  }

  @keyframes chapter-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter__copy {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
