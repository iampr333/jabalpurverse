---
/**
 * Stacked full-bleed place chapters after the Narmada hero.
 * Order: Dhuandhar → Madan Mahal → Marble Rocks. Soft top fades + overlap.
 */
const landmarks = [
  {
    id: "dhuandhar",
    nameHi: "धुआँधार",
    nameEn: "Dhuandhar",
    hintHi: "नर्मदा जलप्रपात",
    hintEn: "Narmada falls",
    image: "/images/atmosphere/dhuandhar-falls.jpg",
    imageAlt: "Dhuandhar Falls on the Narmada near Bhedaghat",
    position: "center 40%",
  },
  {
    id: "madan-mahal",
    nameHi: "मदन महल",
    nameEn: "Madan Mahal",
    hintHi: "पहाड़ी किला",
    hintEn: "Hill fort",
    image: "/images/atmosphere/madan-mahal-fort.jpg",
    imageAlt: "Madan Mahal fort on the hill overlooking Jabalpur",
    position: "center 72%",
  },
  {
    id: "marble-rocks",
    nameHi: "संगमरमर चट्टानें",
    nameEn: "Marble Rocks",
    hintHi: "भेड़ाघाट",
    hintEn: "Bhedaghat",
    image: "/images/atmosphere/marble-rocks-bhedaghat.jpg",
    imageAlt: "Marble Rocks gorge on the Narmada at Bhedaghat",
    position: "center 55%",
  },
] as const;
---

<div class="chapters" aria-label="Jabalpur places along the Narmada">
  {
    landmarks.map((place, index) => (
      <section class:list={["chapter", index === 0 && "chapter--first"]} id={place.id}>
        <img
          class="chapter__photo"
          src={place.image}
          alt={place.imageAlt}
          width="1600"
          height="1067"
          loading={index === 0 ? "eager" : "lazy"}
          decoding="async"
          style={`object-position: ${place.position}`}
        />
        <div class="chapter__veil" aria-hidden="true" />
        <div class="chapter__copy">
          <h2 class="chapter__name">
            <span lang="hi">{place.nameHi}</span>
            <span class="chapter__sep" aria-hidden="true">
              ·
            </span>
            <span>{place.nameEn}</span>
          </h2>
          <p class="chapter__hint">
            <span lang="hi">{place.hintHi}</span>
            <span aria-hidden="true"> · </span>
            <span>{place.hintEn}</span>
          </p>
        </div>
      </section>
    ))
  }
  <p class="chapters__credit">
    Photos: Wikimedia Commons (CC BY-SA) ·
    <a href="/images/credits/ATTRIBUTION.md">Attribution</a>
  </p>
</div>

<style>
  .chapters {
    width: 100%;
    margin: 0;
    background: transparent;
    position: relative;
    z-index: 2;
  }

  .chapter {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    /* Soft TOP fade between chapters only — do not invade the hero viewport. */
    margin-top: -12vh;
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 100%);
  }

  .chapter--first {
    margin-top: 0;
    -webkit-mask-image: none;
    mask-image: none;
  }

  .chapter__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.94) brightness(0.88);
  }

  .chapter__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, #0a4f51 35%, transparent) 0%,
        transparent 24%,
        transparent 55%,
        color-mix(in srgb, #0a4f51 30%, transparent) 82%,
        color-mix(in srgb, #0a4f51 52%, transparent) 100%
      );
    pointer-events: none;
  }

  .chapter__copy {
    position: relative;
    z-index: 1;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 10vh, 5rem);
    max-width: 40rem;
    color: #f7f5f1;
    text-shadow: 0 1px 18px color-mix(in srgb, #0a4f51 55%, transparent);
    opacity: 0;
    transform: translateY(1.25rem);
    animation: chapter-in 0.9s ease forwards;
    animation-timeline: view();
    animation-range: entry 15% cover 40%;
  }

  @supports not (animation-timeline: view()) {
    .chapter__copy {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  .chapter__name {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .chapter__sep {
    margin-inline: 0.35rem;
    opacity: 0.7;
    font-weight: 500;
  }

  .chapter__hint {
    margin: 0;
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    opacity: 0.9;
  }

  .chapters__credit {
    margin: -2vh 0 0;
    padding: 2.5rem 1.25rem 1.25rem;
    font-size: 0.72rem;
    color: color-mix(in srgb, #f7f5f1 60%, transparent);
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, #0a4f51 75%, #1a1c1b) 45%,
      #0a4f51 100%
    );
    position: relative;
    z-index: 2;
  }

  .chapters__credit a {
    color: #d5ecec;
    text-underline-offset: 2px;
  }

  @keyframes chapter-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter__copy {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
