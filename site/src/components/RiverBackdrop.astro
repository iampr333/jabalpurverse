---
---
<!-- Pale Narmada current over marble. Decorative only. -->
<div class="river-backdrop" aria-hidden="true">
  <div class="river-backdrop__sky"></div>
  <div class="river-backdrop__photo"></div>
  <div class="river-backdrop__wash"></div>
  <svg class="river-backdrop__waves" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="paleRiver" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#d5ecec" stop-opacity="0" />
        <stop offset="40%" stop-color="#d5ecec" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#0f6b6d" stop-opacity="0.12" />
      </linearGradient>
    </defs>
    <rect width="1440" height="900" fill="url(#paleRiver)" />
    <g class="river-backdrop__flow river-backdrop__flow--a" fill="none" stroke="#0f6b6d" stroke-opacity="0.14" stroke-width="1.4" stroke-linecap="round">
      <path d="M-200 220 C 80 180, 280 260, 560 220 S 1040 160, 1320 210 S 1680 260, 1800 220" />
      <path d="M-200 280 C 120 240, 320 320, 600 280 S 1080 220, 1360 270 S 1720 320, 1800 280" />
    </g>
    <g class="river-backdrop__flow river-backdrop__flow--b" fill="none" stroke="#0a4f51" stroke-opacity="0.09" stroke-width="1.8" stroke-linecap="round">
      <path d="M-240 340 C 40 300, 300 380, 580 340 S 1060 280, 1340 330 S 1700 380, 1840 340" />
    </g>
    <g class="river-backdrop__flow river-backdrop__flow--c" fill="none" stroke="#ffffff" stroke-opacity="0.4" stroke-width="1.2" stroke-linecap="round">
      <path d="M-160 400 C 160 370, 400 440, 680 400 S 1160 350, 1440 390 S 1760 440, 1760 400" />
    </g>
  </svg>
  <div class="river-backdrop__dawn"></div>
</div>

<style>
  .river-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--marble);
  }

  .river-backdrop__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1000px 520px at 12% 0%, color-mix(in srgb, var(--river-soft) 70%, white), transparent 55%),
      radial-gradient(800px 420px at 92% 8%, color-mix(in srgb, var(--diya-soft) 65%, transparent), transparent 55%),
      var(--marble);
  }

  .river-backdrop__photo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background-image: url("/images/atmosphere/marble-rocks-bhedaghat.jpg");
    background-size: cover;
    background-position: center 55%;
    opacity: 0.09;
    filter: saturate(0.7) brightness(1.15);
    mask-image: linear-gradient(180deg, transparent 0%, black 40%, black 100%);
  }

  .river-backdrop__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        var(--marble) 0%,
        var(--marble) 42%,
        color-mix(in srgb, var(--marble) 82%, transparent) 68%,
        transparent 100%
      ),
      linear-gradient(0deg, color-mix(in srgb, var(--river-soft) 45%, var(--marble)) 0%, transparent 28%);
  }

  .river-backdrop__waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 38%;
    opacity: 0.55;
    mask-image: linear-gradient(180deg, transparent 0%, black 45%);
  }

  .river-backdrop__dawn {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--diya), transparent);
    opacity: 0.5;
  }

  .river-backdrop__flow--a {
    animation: river-drift 36s linear infinite;
  }
  .river-backdrop__flow--b {
    animation: river-drift 48s linear infinite reverse;
  }
  .river-backdrop__flow--c {
    animation: river-drift 28s linear infinite;
  }

  @keyframes river-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-160px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .river-backdrop__flow--a,
    .river-backdrop__flow--b,
    .river-backdrop__flow--c {
      animation: none !important;
    }
  }
</style>
