---
---
<!-- Pale Narmada current over marble. Decorative only. -->
<div class="river-backdrop" aria-hidden="true">
  <div class="river-backdrop__sky"></div>
  <div class="river-backdrop__photo"></div>
  <div class="river-backdrop__wash"></div>
  <svg class="river-backdrop__waves" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="paleRiver" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#d5ecec" stop-opacity="0" />
        <stop offset="40%" stop-color="#d5ecec" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#0f6b6d" stop-opacity="0.12" />
      </linearGradient>
    </defs>
    <rect width="1440" height="900" fill="url(#paleRiver)" />
    <g class="river-backdrop__flow river-backdrop__flow--a" fill="none" stroke="#0f6b6d" stroke-opacity="0.16" stroke-width="1.4" stroke-linecap="round">
      <path d="M-200 560 C 80 520, 280 600, 560 560 S 1040 500, 1320 550 S 1680 600, 1800 560" />
      <path d="M-200 600 C 120 560, 320 640, 600 600 S 1080 540, 1360 590 S 1720 640, 1800 600" />
    </g>
    <g class="river-backdrop__flow river-backdrop__flow--b" fill="none" stroke="#0a4f51" stroke-opacity="0.1" stroke-width="1.8" stroke-linecap="round">
      <path d="M-240 650 C 40 610, 300 690, 580 650 S 1060 590, 1340 640 S 1700 690, 1840 650" />
    </g>
    <g class="river-backdrop__flow river-backdrop__flow--c" fill="none" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.2" stroke-linecap="round">
      <path d="M-160 690 C 160 660, 400 730, 680 690 S 1160 640, 1440 680 S 1760 730, 1760 690" />
    </g>
  </svg>
  <div class="river-backdrop__dawn"></div>
</div>

<style>
  .river-backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--marble);
  }

  .river-backdrop__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1000px 520px at 12% 0%, color-mix(in srgb, var(--river-soft) 70%, white), transparent 55%),
      radial-gradient(800px 420px at 92% 8%, color-mix(in srgb, var(--diya-soft) 65%, transparent), transparent 55%),
      var(--marble);
  }

  .river-backdrop__photo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 58%;
    background-image: url("/images/atmosphere/marble-rocks-bhedaghat.jpg");
    background-size: cover;
    background-position: center 55%;
    opacity: 0.11;
    filter: saturate(0.7) brightness(1.15);
    mask-image: linear-gradient(180deg, transparent 0%, black 35%, black 100%);
  }

  .river-backdrop__wash {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--marble) 0%, color-mix(in srgb, var(--marble) 88%, transparent) 38%, transparent 62%),
      linear-gradient(0deg, color-mix(in srgb, var(--river-soft) 55%, var(--marble)) 0%, transparent 38%);
  }

  .river-backdrop__waves {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .river-backdrop__dawn {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--diya), transparent);
    opacity: 0.5;
  }

  .river-backdrop__flow--a {
    animation: river-drift 36s linear infinite;
  }
  .river-backdrop__flow--b {
    animation: river-drift 48s linear infinite reverse;
  }
  .river-backdrop__flow--c {
    animation: river-drift 28s linear infinite;
  }

  @keyframes river-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-160px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .river-backdrop__flow--a,
    .river-backdrop__flow--b,
    .river-backdrop__flow--c {
      animation: none !important;
    }
  }
</style>
