---
import "../styles/app.css";
import RiverBackdrop from "../components/RiverBackdrop.astro";

interface Props {
  title?: string;
  description?: string;
  /** Pale marble river wash — for Support and light pages, not photo-led home. */
  river?: boolean;
}

const {
  title = "Jabalpurverse",
  description = "Explore Jabalpur. Discover its stories.",
  river = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Serif+Devanagari:wght@500;600&family=Source+Sans+3:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="relative min-h-dvh">
    {river && <RiverBackdrop />}
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
